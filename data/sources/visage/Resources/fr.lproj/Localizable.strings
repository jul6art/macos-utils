/* Visage, en français. Les clés sont les textes anglais. */

/* Se connecter à mon IA */
"Connect my AI" = "Se connecter à mon IA";
"Connect my AI…" = "Se connecter à mon IA…";
"Visage gives a face to the voice of the AI app you already use. It only hears that app's sound, and nothing leaves your Mac." = "Visage donne un visage à la voix de l'IA que vous utilisez déjà. Il n'entend que le son de cette app, et rien ne quitte votre Mac.";
"Another app" = "Une autre app";
"Connect" = "Se connecter";
"Reconnect" = "Se reconnecter";
"Download" = "Télécharger";
"Connected" = "Connecté";
"Open" = "Ouverte";
"Installed" = "Installée";
"Not installed" = "Non installée";
"Pick the app you talk to." = "Choisissez l'app à laquelle vous parlez.";
"%@ is not installed on this Mac." = "%@ n'est pas installée sur ce Mac.";
"Connecting…" = "Connexion…";
"macOS asks whether Visage may record system audio: allow it." = "macOS demande si Visage peut enregistrer l'audio du système : autorisez-le.";
"Visage cannot hear %@ yet. Allow it in System Settings, under Privacy & Security, Screen & System Audio Recording." = "Visage n'entend pas encore %@. Autorisez-le dans Réglages Système, sous Confidentialité et sécurité, Enregistrement de l'écran et de l'audio du système.";
"Open System Settings" = "Ouvrir Réglages Système";
"Start voice mode in %@: Visage connects as soon as it speaks." = "Lancez le mode vocal dans %@ : Visage se connecte dès qu'il parle.";
"Connected to %@. Start voice mode and talk." = "Connecté à %@. Lancez le mode vocal et parlez.";
"Connected to %@, which is listening: talk to it." = "Connecté à %@, qui vous écoute : parlez-lui.";
"Connected to Claude. Start its voice mode: the sound-wave button, at the bottom right of its window." = "Connecté à Claude. Lancez son mode vocal : le bouton en forme d'onde sonore, en bas à droite de sa fenêtre.";
"Show the face" = "Afficher le visage";
"The connection failed: %@" = "La connexion a échoué : %@";

